# ---- Dependencies (everyone regenerates these with `npm install`) ----
node_modules/

# ---- Build output ----
dist/
dist-ssr/
*.local

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editor / IDE files ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Environment / secrets (never commit these) ----
.env
.env.local
.env.*.local

# ---- npm/vite cache ----
.npm
.vite/
